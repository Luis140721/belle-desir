+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  border-radius: 50%;
+  width: 36px;
+  height: 36px;
+}
+
+.btn-agregar-carrito:hover:not(:disabled) {
+  transform: scale(1.1);
+  box-shadow: 0 4px 16px rgba(91, 42, 134, 0.5);
+}
+
+.btn-agregar-carrito:disabled {
+  background: rgba(196, 168, 232, 0.1);
+  color: var(--texto-gris);
