+  font-size: 0.7rem;
+  border-radius: var(--radius-sm);
+  width: auto;
+  height: auto;
+  padding: 6px 10px;
+}
+
+.btn-agregar-carrito.agregado {
+  background: linear-gradient(135deg, #2a7a4f, #1e6640);
+}
+
+/* ---- MODAL DE PRODUCTO (REDISEÑO ULTRA-LUXURY) ---- */
+
+.product-modal-overlay {
+  position: fixed;
+  inset: 0;
+  background: radial-gradient(circle at center, rgba(30, 20, 45, 0.8), rgba(11, 5, 18, 0.95));
+  backdrop-filter: blur(20px);
+  -webkit-backdrop-filter: blur(20px);
+  z-index: 10000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 2rem;
+  opacity: 0;
+  visibility: hidden;
+  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.product-modal-overlay.active {
+  opacity: 1;
+  visibility: visible;
+}
+
+.product-modal-container {
+  width: 100%;
+  max-width: 1150px;
+  height: min(850px, 88vh);
+  background: rgba(255, 255, 255, 0.03);
+  backdrop-filter: blur(60px);
+  -webkit-backdrop-filter: blur(60px);
+  border: 1px solid rgba(196, 168, 232, 0.2);
+  border-radius: 44px;
+  overflow: hidden;
+  position: relative;
+  display: flex;
+  transform: scale(0.9) translateY(40px);
+  transition: all 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
+  box-shadow: 
+    0 0 0 1px rgba(196, 168, 232, 0.1),
+    0 30px 100px rgba(0, 0, 0, 0.7),
+    inset 0 0 20px rgba(196, 168, 232, 0.05);
+}
+
+/* Glass Shine Effect */
+.product-modal-container::before {
+  content: '';
+  position: absolute;
+  top: -100%;
+  left: -100%;
+  width: 300%;
+  height: 300%;
+  background: linear-gradient(
+    45deg,
+    transparent 45%,
+    rgba(255, 255, 255, 0.03) 50%,
+    transparent 55%
+  );
+  transform: rotate(25deg);
+  pointer-events: none;
+  z-index: 1;
+}
+
+.product-modal-overlay.active .product-modal-container {
+  transform: scale(1) translateY(0);
+}
+
+.product-modal-close {
+  position: absolute;
+  top: 2.5rem;
+  right: 2.5rem;
+  width: 48px;
+  height: 48px;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.03);
+  backdrop-filter: blur(10px);
+  border: 1px solid rgba(196, 168, 232, 0.2);
+  color: var(--champana);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  z-index: 30;
+  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
+  font-size: 1.6rem;
+}
+
+.product-modal-close:hover {
+  background: var(--violeta-premium);
+  color: var(--blanco);
+  transform: rotate(90deg) scale(1.1);
+  box-shadow: 0 0 20px rgba(91, 42, 134, 0.4);
+}
+
+.product-modal-content {
+  display: grid;
+  grid-template-columns: 1.15fr 0.85fr;
+  width: 100%;
+  height: 100%;
+}
+
+@media (max-width: 950px) {
+  .product-modal-overlay { padding: 1rem; }
+  .product-modal-container { 
+    height: 94vh;
+    border-radius: 32px;
+    max-width: 500px;
+  }
+  .product-modal-content {
+    grid-template-columns: 1fr;
+    grid-template-rows: auto 1fr;
+    overflow-y: auto;
+  }
+  .product-modal-media {
+    height: 380px;
+    border-right: none;
+    border-bottom: 1px solid rgba(196, 168, 232, 0.1);
+  }
+  .product-modal-details {
+    padding: 2.5rem 2rem;
+    overflow-y: visible;
+  }
+  .product-modal-title { font-size: 2rem; }
+  .product-modal-price { font-size: 1.6rem; margin-bottom: 1.5rem; }
+  .product-modal-description { font-size: 0.95rem; margin-bottom: 1.5rem; }
+  .product-modal-close {
+    top: 1.25rem;
+    right: 1.25rem;
+    width: 40px;
+    height: 40px;
+    font-size: 1.2rem;
+  }
+}
+
+/* ---- Bottom-sheet drag handle (hidden on desktop) ---- */
+.product-modal-drag-handle {
+  display: none;
+}
+
+/* ---- Bottom-sheet modal on very small screens (≤ 500px) ---- */
+@media (max-width: 500px) {
+  /* Overlay anchors to bottom edge */
+  .product-modal-overlay {
+    padding: 0;
+    align-items: flex-end;
+  }
+
+  /* Sheet slides up from bottom; override scale animation */
+  .product-modal-container {
+    width: 100%;
+    max-width: 100%;
+    height: auto;
+    max-height: 82svh;
+    border-radius: 24px 24px 0 0;
+    transform: translateY(100%);
+    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
+  }
+
+  .product-modal-overlay.active .product-modal-container {
+    transform: translateY(0);
+  }
+
+  .product-modal-drag-handle {
+    display: block;
+    width: 40px;
+    height: 4px;
+    background: rgba(196, 168, 232, 0.3);
+    border-radius: 2px;
+    margin: 0.75rem auto 0;
+    flex-shrink: 0;
+  }
+
+  .product-modal-content {
+    grid-template-columns: 1fr;
+    grid-template-rows: auto 1fr;
+    overflow: hidden;
+    max-height: calc(82svh - 1.75rem);
+    overscroll-behavior: contain;
+  }
+
+  .product-modal-media { height: 200px; }
+  .product-modal-media img {
+    padding: 0;
+    object-fit: cover;
+  }
+
+  .product-modal-details {
+    padding: 1.15rem 1.25rem;
+    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
+    display: flex;
+    flex-direction: column;
+    min-height: 0;
+    overflow-y: auto;
+  }
+
+  .product-modal-title {
+    font-size: 1.25rem;
+    margin-bottom: 0.6rem;
+    line-height: 1.2;
+    display: -webkit-box;
+    -webkit-line-clamp: 2;
+    -webkit-box-orient: vertical;
+    overflow: hidden;
+  }
+
+  .product-modal-price {
+    font-size: 1.15rem;
+    margin-bottom: 0.85rem;
+  }
+
+  .product-modal-description {
+    font-size: 0.82rem;
+    margin-bottom: 0.85rem;
+    line-height: 1.6;
+    flex: 0 0 auto;
+    overflow: visible;
+  }
+
+  .product-modal-category {
+    font-size: 0.7rem;
+    letter-spacing: 0.22em;
+    margin-bottom: 0.6rem;
+  }
+
+  .modal-nav-btn {
+    width: 38px;
+    height: 38px;
+    font-size: 1.3rem;
+  }
+
+  .modal-nav-btn.prev { left: 0.75rem; }
+  .modal-nav-btn.next { right: 0.75rem; }
+
+  .modal-indicators {
+    bottom: 0.9rem;
+    gap: 0.55rem;
+  }
+
+
+  .product-modal-actions {
+    position: sticky;
+    bottom: 0;
+    margin-top: 0.75rem;
+    padding-top: 0.75rem;
+    background: linear-gradient(to top, rgba(18, 11, 24, 0.96) 70%, rgba(18, 11, 24, 0));
+    backdrop-filter: blur(18px);
+    -webkit-backdrop-filter: blur(18px);
+  }
+
+  .product-modal-quantity {
+    justify-content: space-between;
+    gap: 1rem;
+  }
+
+  .product-modal-actions .btn-primario {
+    padding: 1rem;
+    font-size: 0.9rem;
+    border-radius: 12px;
+  }
+
+  /* Close button moves inside sheet */
+  .product-modal-close {
+    top: 1rem;
+    right: 1rem;
+    width: 44px;
+    height: 44px;
+    font-size: 1.2rem;
+  }
+}
+
+@media (max-width: 768px) {
+  .navbar-menu .navbar-dropdown .dropdown-menu {
+    display: none !important;
+  }
