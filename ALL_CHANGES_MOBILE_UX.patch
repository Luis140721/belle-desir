+.producto-card-precio {
+  font-family: var(--font-serif);
+  font-size: 1.3rem;
+  color: var(--lila-claro);
+  font-weight: 500;
+}
+
+/* ---- BOTÓN AGREGAR AL CARRITO (tarjeta) ---- */
+
+.btn-agregar-carrito {
+  background: linear-gradient(135deg, var(--violeta-premium), var(--morado-oscuro));
+  border: none;
+  color: var(--champana);
+  cursor: pointer;
+  font-size: 1.3rem;
+  font-weight: 500;
+  line-height: 1;
+  transition: all var(--transition-fast);
