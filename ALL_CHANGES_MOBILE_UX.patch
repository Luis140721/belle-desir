+/* ============================================
+   COMPONENTS.CSS — Botones, tarjetas, badges
+   y elementos reutilizables
+   ============================================ */
+
+/* ---- BOTONES ---- */
+
+.btn-primario {
+  background: linear-gradient(135deg, var(--violeta-premium), var(--morado-oscuro));
+  color: var(--champana);
+  border: none;
+  padding: 14px 28px;
+  border-radius: var(--radius-sm);
+  font-size: 0.95rem;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  cursor: pointer;
+  text-decoration: none;
+  display: inline-block;
+  transition: all var(--transition-normal);
+  position: relative;
+  overflow: hidden;
+  font-family: var(--font-sans);
+}
+
+.btn-primario::before {
+  content: '';
+  position: absolute;
+  top: 0; left: -100%;
+  width: 100%; height: 100%;
+  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
+  transition: left var(--transition-slow);
+}
+.btn-primario:hover::before { left: 100%; }
+.btn-primario:hover {
+  transform: translateY(-2px);
+  box-shadow: var(--shadow-violet);
+}
+
+.btn-secundario {
+  background-color: transparent;
+  color: var(--texto-gris);
+  border: 1px solid rgba(196, 168, 232, 0.2);
+  padding: 14px 28px;
+  border-radius: var(--radius-sm);
+  font-size: 0.9rem;
+  letter-spacing: 0.05em;
+  cursor: pointer;
+  transition: all var(--transition-normal);
+  font-family: var(--font-sans);
+}
+.btn-secundario:hover {
+  border-color: var(--lila-claro);
+  color: var(--lila-claro);
+}
+
+/* ---- ETIQUETAS DE SECCIÓN ---- */
+
+.seccion-eyebrow {
+  font-size: 0.75rem;
+  letter-spacing: 0.3em;
+  text-transform: uppercase;
+  color: var(--lila-claro);
+  margin-bottom: 1rem;
+}
+
+.seccion-titulo {
+  font-family: var(--font-serif);
+  font-size: 3rem;
+  font-weight: 300;
+  color: var(--champana);
+  line-height: 1.2;
+  margin-bottom: 1.5rem;
+}
+.seccion-titulo em {
+  color: var(--lila-claro);
+  font-style: italic;
+}
+
+.seccion-linea {
+  width: 50px;
+  height: 1px;
+  background: linear-gradient(90deg, transparent, var(--lila-claro), transparent);
+  margin: 0 auto;
+}
+
+/* ---- TARJETAS DE VALOR ---- */
+
+.valor-tarjeta {
+  background: rgba(255, 255, 255, 0.03);
