+  background: rgba(45, 30, 65, 0.55);
+  border-color: rgba(196, 168, 232, 0.4);
+  box-shadow: 0 15px 45px rgba(196, 168, 232, 0.15);
+}
+
+.producto-card-imagen {
+  aspect-ratio: 1;
+  background: linear-gradient(135deg, rgba(91, 42, 134, 0.2), rgba(18, 11, 24, 0.4));
