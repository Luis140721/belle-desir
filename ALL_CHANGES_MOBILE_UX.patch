+}
+
+/* ======================================================
+   ETIQUETAS FLOTANTES DEL CUBO 3D (GSAP ScrollTrigger)
+   ====================================================== */
+
+.cubo-etiqueta {
+  position: absolute;
+  top: 50%;             /* GSAP aplica yPercent: -50 para centrar */
+  white-space: nowrap;
+  pointer-events: none;
+
+  /* Glassmorphism */
+  background: rgba(91, 42, 134, 0.35);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+  border: 1px solid rgba(196, 168, 232, 0.22);
+  border-radius: 50px;
+  padding: 0.45rem 1.1rem;
+
+  /* Tipografía */
+  font-family: var(--font-sans);
+  font-size: 0.68rem;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--champana);
+
+  /* Glow sutil */
+  box-shadow:
+    0 4px 20px rgba(91, 42, 134, 0.3),
+    inset 0 0 12px rgba(196, 168, 232, 0.05);
+}
+
+/* Etiqueta a la IZQUIERDA del cubo */
+.cubo-etiqueta--izq {
+  right: calc(100% + 22px);
+}
+
+/* Etiqueta a la DERECHA del cubo */
+.cubo-etiqueta--der {
+  left: calc(100% + 22px);
+}
+
+/* ======================================================
+   PRODUCT DETAIL DESIGNS (BEAUTIFUL CAROUSEL & LAYOUT)
+   ====================================================== */
+.product-detail-page {
+  min-height: 100vh;
+  background: var(--negro-ciruela);
+  padding: 6rem 1.5rem 4rem;
+}
+
+.product-detail-container {
+  max-width: 1200px;
+  margin: 0 auto;
+}
+
+.product-detail-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 4rem;
+  align-items: start;
+}
+
+/* GALLERY / CAROUSEL */
+.product-gallery {
+  display: flex;
+  flex-direction: column;
+  gap: 1.5rem;
+  position: sticky;
+  top: 6rem;
+}
+
+.main-image-container {
+  aspect-ratio: 1;
+  background: rgba(255, 255, 255, 0.02);
+  border: 1px solid rgba(196, 168, 232, 0.15);
+  border-radius: var(--radius-lg);
+  overflow: hidden;
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: 0 10px 40px rgba(91, 42, 134, 0.15);
+}
+
+.main-image {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition: opacity 0.3s ease-in-out, transform 0.3s ease-out;
+}
+
+.main-image.fade {
+  opacity: 0.3;
+  transform: scale(0.98);
+}
+
+.thumbnail-grid {
+  display: flex;
+  gap: 1rem;
+  overflow-x: auto;
+  padding-bottom: 0.5rem;
+  scrollbar-width: thin;
+  scrollbar-color: var(--lila-claro) transparent;
+}
+
+.thumbnail-btn {
+  width: 80px;
+  height: 80px;
+  flex-shrink: 0;
+  background: transparent;
+  border: 2px solid transparent;
+  border-radius: var(--radius-sm);
+  overflow: hidden;
+  cursor: pointer;
+  padding: 0;
+  transition: all var(--transition-normal);
+  opacity: 0.5;
+}
+
+.thumbnail-btn img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.thumbnail-btn:hover {
+  opacity: 0.9;
+  transform: translateY(-4px);
+}
+
+.thumbnail-btn.active {
+  opacity: 1;
+  border-color: var(--lila-claro);
+  box-shadow: 0 4px 12px rgba(196, 168, 232, 0.4);
+  transform: translateY(-4px);
+}
+
+/* PRODUCT INFO COLUMN */
+.product-info {
+  display: flex;
+  flex-direction: column;
+  gap: 1.2rem;
+}
+.product-title {
+  font-family: var(--font-serif);
+  font-size: 2.8rem;
+  font-weight: 300;
+  color: var(--champana);
+  line-height: 1.1;
+  margin-bottom: 0.5rem;
+}
+.product-price-section {
+  display: flex;
+  align-items: baseline;
+  gap: 1rem;
+  margin-bottom: 1rem;
+}
+.product-price {
+  font-family: var(--font-serif);
+  font-size: 2.2rem;
+  color: var(--lila-claro);
+}
+.product-compare-price {
+  font-size: 1.2rem;
+  color: var(--texto-gris);
+  text-decoration: line-through;
+  opacity: 0.5;
+}
+.product-description {
+  font-size: 1.05rem;
+  color: var(--texto-gris);
+  line-height: 1.8;
+  letter-spacing: 0.02em;
+  margin-bottom: 1rem;
+}
+.product-badges {
+  display: flex;
+  gap: 0.5rem;
+}
+.product-actions {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 1rem;
+  margin-top: 1rem;
+}
+.quantity-selector {
+  display: flex;
+  align-items: center;
+  gap: 1.5rem;
+  background: rgba(255, 255, 255, 0.02);
+  border: 1px solid rgba(196, 168, 232, 0.15);
+  padding: 0.5rem 1rem;
+  border-radius: 50px;
+  width: fit-content;
+}
+.quantity-input {
+  display: flex;
+  align-items: center;
+}
+.qty-btn {
+  background: rgba(196, 168, 232, 0.1);
+  border: none;
+  color: var(--champana);
+  width: 35px;
+  height: 35px;
+  border-radius: 50%;
+  font-size: 1.2rem;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: all var(--transition-fast);
+}
+.qty-btn:hover:not(:disabled) {
+  background: var(--lila-claro);
+  color: var(--negro-ciruela);
+  transform: scale(1.1);
+}
+.qty-btn:disabled {
+  opacity: 0.2;
+  cursor: not-allowed;
+}
+.quantity-input input {
+  background: transparent;
+  border: none;
+  color: var(--champana);
+  width: 50px;
+  text-align: center;
+  font-size: 1.2rem;
+  pointer-events: none;
+}
+
+/* ======================================================
+   CARD CAROUSEL (PRODUCT CATALOG MULTI-IMAGE)
+   ====================================================== */
+.card-carousel {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+}
+
+.card-carousel-track {
+  display: flex;
+  width: 100%;
+  height: 100%;
+  overflow-x: auto;
+  scroll-snap-type: x mandatory;
+  scrollbar-width: none; /* Firefox */
+  scroll-behavior: smooth;
+}
+
+.card-carousel-track::-webkit-scrollbar {
+  display: none; /* Chrome, Safari */
+}
+
+.card-carousel-track img {
+  flex: 0 0 100%;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  scroll-snap-align: center;
+}
+
+.card-carousel-indicators {
+  position: absolute;
+  bottom: 8px;
+  left: 0;
+  width: 100%;
+  display: flex;
+  justify-content: center;
+  gap: 4px;
+  pointer-events: auto;
+  z-index: 10;
+}
+
+.card-carousel-indicators .indicator {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.4);
+  backdrop-filter: blur(2px);
+  transition: all var(--transition-fast);
+  cursor: pointer;
+}
+
+.card-carousel-indicators .indicator.active {
+  background: var(--lila-claro);
+  transform: scale(1.2);
+}
+
+.carousel-btn {
+  position: absolute;
+  top: 50%;
+  transform: translateY(-50%);
+  background: rgba(18, 11, 24, 0.6);
+  backdrop-filter: blur(4px);
+  color: var(--champana);
+  border: 1px solid rgba(196, 168, 232, 0.3);
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1.2rem;
+  cursor: pointer;
+  /* On mobile, always show them a bit faded, full opacity on hover */
+  opacity: 0.8;
+  transition: all var(--transition-normal);
+  z-index: 10;
+  line-height: 1;
+}
+
+.card-carousel:hover .carousel-btn {
+  opacity: 1;
+}
+
+.carousel-btn:hover {
+  background: var(--violeta-premium);
+  transform: translateY(-50%) scale(1.1);
+}
+
+.carousel-btn.prev-btn {
+  left: 6px;
+}
+
+.carousel-btn.next-btn {
+  right: 6px;
+}
+
+/* ======================================================
+   FLOATING CONTACT BUTTONS
+   ====================================================== */
+.floating-cart-btn,
+.floating-whatsapp-btn {
+  position: fixed;
+  bottom: 1.6rem;
+  min-height: 62px;
+  border-radius: 999px;
+  color: var(--champana);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.8rem;
+  padding: 0.65rem 1rem 0.65rem 0.7rem;
+  border: 1px solid rgba(212, 196, 168, 0.18);
+  text-decoration: none;
+  backdrop-filter: blur(18px);
+  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.42);
+  cursor: pointer;
+  z-index: 9500;
+  transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease, opacity 0.3s ease, visibility 0.3s ease;
+}
+
+.floating-cart-btn.oculto-sidebar {
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+}
+
+body.nav-drawer-open .floating-cart-btn,
+body.nav-drawer-open .floating-whatsapp-btn {
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+}
+
+.floating-cart-btn {
+  right: 1.5rem;
+  background:
+    linear-gradient(135deg, rgba(91, 42, 134, 0.96), rgba(27, 15, 39, 0.98)),
+    radial-gradient(circle at top left, rgba(212, 196, 168, 0.24), transparent 42%);
+  animation: pulse-button 3s infinite;
+}
+
+@keyframes pulse-button {
+  0% {
+    box-shadow: 0 0 0 0 rgba(196, 168, 232, 0.4);
+  }
+  70% {
+    box-shadow: 0 0 0 15px rgba(196, 168, 232, 0);
+  }
+  100% {
+    box-shadow: 0 0 0 0 rgba(196, 168, 232, 0);
+  }
+}
+
+.floating-whatsapp-btn {
+  left: 1.5rem;
+  background:
+    linear-gradient(135deg, rgba(7, 94, 84, 0.96), rgba(18, 140, 126, 0.88)),
+    radial-gradient(circle at top left, rgba(212, 196, 168, 0.22), transparent 44%);
+}
+
+.floating-cart-btn:hover,
+.floating-whatsapp-btn:hover {
+  transform: translateY(-4px);
+  border-color: rgba(212, 196, 168, 0.4);
+  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
+}
+
+.floating-btn-icon {
+  width: 46px;
+  height: 46px;
+  flex: 0 0 46px;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.1);
+  border: 1px solid rgba(212, 196, 168, 0.18);
+  font-size: 1.35rem;
+}
+
+.floating-btn-text {
+  display: flex;
+  flex-direction: column;
+  gap: 0.12rem;
+  line-height: 1.05;
+  white-space: nowrap;
+}
+
+.floating-btn-text strong {
+  font-family: var(--font-serif);
+  font-size: 1rem;
+  font-weight: 500;
+  letter-spacing: 0.02em;
+}
+
+.floating-btn-text small {
+  color: rgba(245, 238, 226, 0.72);
+  font-size: 0.68rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.floating-cart-badge {
+  position: absolute;
+  top: -5px;
+  right: -5px;
+  background: linear-gradient(135deg, var(--champana), var(--lila-claro));
+  color: var(--champana);
+  color: var(--negro-ciruela);
+  font-size: 0.8rem;
+  font-weight: bold;
+  height: 24px;
+  min-width: 24px;
+  border-radius: 12px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border: 2px solid var(--negro-ciruela);
+  padding: 0 6px;
+}
+
+/* Make sure it drops safely to the right corner on tiny screens */
+@media (max-width: 768px) {
+  .floating-cart-btn,
+  .floating-whatsapp-btn {
+    bottom: calc(1rem + env(safe-area-inset-bottom));
+    width: 52px;
+    height: 52px;
+    min-height: 52px;
+    padding: 0;
+    border-radius: 50%;
+    gap: 0;
+  }
+
+  .floating-cart-btn {
+    right: 1rem;
+    animation: none;
+  }
+
+  .floating-whatsapp-btn {
+    left: 1rem;
+  }
+
+  .floating-btn-icon {
+    width: 44px;
+    height: 44px;
+    flex-basis: 44px;
+    font-size: 1.2rem;
+    background: transparent;
+    border: none;
+  }
+
+  .floating-btn-text {
+    display: none;
+  }
+}
