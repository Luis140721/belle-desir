# ========================================
# Belle Desir Backend - Production Environment Example
# Render + Neon + Vercel/Cloudflare Pages
# ========================================
# Copy this as a reference only. Never commit real production values.

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server Configuration
NODE_ENV=production
PORT=3001

# JWT Configuration - generate unique secure values, 32+ chars each
JWT_SECRET=replace_with_32_plus_chars_secret
JWT_ACCESS_SECRET=replace_with_32_plus_chars_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_chars_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS URLs - update with real deployed URLs
FRONTEND_URL=https://tu-tienda.vercel.app
ADMIN_URL=https://tu-admin.vercel.app

# Storage Configuration
STORAGE_PROVIDER=cloudinary

# Cloudinary - Images Storage
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# Bold Colombia - Payments
BOLD_API_KEY=tu_bold_api_key
BOLD_INTEGRITY_SECRET=tu_bold_integrity_secret

# Resend - Email Service (optional)
RESEND_API_KEY=re_tu_api_key
FROM_EMAIL=noreply@belledesir.com

# Google Sign-In
GOOGLE_CLIENT_ID=tu_google_oauth_client_id.apps.googleusercontent.com
