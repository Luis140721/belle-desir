# Backend environment example for Belle Desir
# Copy only the values you need into .env.local for local development.
# Never commit real secrets.

# Database - required in every environment
DATABASE_URL=postgresql://user:password@host:5432/belle_desir?sslmode=require

# Server
NODE_ENV=development
PORT=3001

# Local CORS
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# JWT - production must use unique random secrets with 32+ chars
JWT_SECRET=replace_with_32_plus_chars_secret
JWT_ACCESS_SECRET=replace_with_32_plus_chars_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_chars_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage - optional at local boot, required for image uploads
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bold Colombia - optional at local boot, required for checkout/payment links
BOLD_API_KEY=
BOLD_INTEGRITY_SECRET=

# Email - optional
RESEND_API_KEY=
FROM_EMAIL=noreply@belledesir.com

# Google Sign-In - optional until enabled in frontend
GOOGLE_CLIENT_ID=
